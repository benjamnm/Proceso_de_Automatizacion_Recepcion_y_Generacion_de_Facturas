# Copie este archivo como ".env" en esta misma carpeta y complete los valores.
# ".env" está excluido de Git: nunca lo suba al repositorio.

# Genere una clave con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FLASK_DEBUG=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=facturaciones_spa_mvp
DB_USER=root
DB_PASSWORD=

# Opcional: carpeta privada para los XML (por defecto app/registros/xml)
# XML_UPLOAD_FOLDER=

# SMTP (Incremento 1). SMTP_SECURITY: starttls | ssl | none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
