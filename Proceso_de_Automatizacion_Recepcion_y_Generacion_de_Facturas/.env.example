# Copie este archivo como ".env" en esta misma carpeta y complete los valores.
# ".env" está excluido de Git: nunca lo suba al repositorio.

# Genere una clave con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FLASK_DEBUG=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=facturaciones_spa_mvp
DB_USER=root
DB_PASSWORD=

# Opcional: carpeta privada para los XML (por defecto app/registros/xml)
# XML_UPLOAD_FOLDER=

# ---------------------------------------------------------------------
# SMTP. SMTP_SECURITY: starttls | ssl | none (none solo con localhost)
#
# Desarrollo (Mailpit local: captura todo, no entrega a nadie):
#   SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_SECURITY=none
#   SMTP_USER y SMTP_PASSWORD vacíos. Bandeja: http://localhost:8025
#
# Demo / producción (Brevo, relay SMTP con STARTTLS):
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#   SMTP_USER=<login SMTP de Brevo>  SMTP_PASSWORD=<clave SMTP de Brevo>
#   SMTP_FROM debe ser un remitente o dominio verificado en Brevo.
#
# Prueba de configuración:
#   flask --app run smtp-prueba su_correo@dominio.cl
# ---------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Facturaciones SpA <no-responder@facturaciones.cl>
SMTP_TIMEOUT=20

# ---------------------------------------------------------------------
# IMAP: bandeja de ENTRADA donde llegan las solicitudes de factura.
# (El correo se recibe por IMAP; SMTP solo envía.)
# IMAP_SECURITY: ssl (puerto 993) | starttls (puerto 143) | none (solo localhost)
#
# Desarrollo local (GreenMail, captura SMTP+IMAP sin Internet):
#   docker run -p 3025:3025 -p 3143:3143 greenmail/standalone
#   IMAP_HOST=localhost  IMAP_PORT=3143  IMAP_SECURITY=none
#   IMAP_USER=facturas@localhost  IMAP_PASSWORD=facturas@localhost
#
# Demo / producción (cuenta dedicada con IMAP habilitado, p. ej. Gmail
# con "contraseña de aplicación"; no usa la API de Gmail):
#   IMAP_HOST=imap.gmail.com  IMAP_PORT=993  IMAP_SECURITY=ssl
#
# Prueba de configuración:   flask --app run imap-prueba
# Revisión manual/programada: flask --app run correo-revisar
# ---------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURITY=ssl
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_TIMEOUT=30
IMAP_MAX_MENSAJES=25
IMAP_MAX_BYTES=10485760

# Opcional: carpetas privadas (por defecto app/registros/correos y app/registros/sii)
# CORREOS_FOLDER=
# SII_FOLDER=

# Usuario técnico creado por migrations/003_flujo_correo_factura.sql
SISTEMA_CORREO_EMAIL=sistema.correo@facturaciones.cl

# Avisos de "factura lista para validar". Vacío = todos los Administradores
# activos. Varios correos separados por coma.
NOTIFICAR_A=
APP_BASE_URL=http://127.0.0.1:5000

# Datos del emisor (su empresa) para el archivo DTE del SII.
EMPRESA_RUT=
EMPRESA_RAZON_SOCIAL=
EMPRESA_GIRO=
EMPRESA_ACTECO=
EMPRESA_DIRECCION=
EMPRESA_COMUNA=
