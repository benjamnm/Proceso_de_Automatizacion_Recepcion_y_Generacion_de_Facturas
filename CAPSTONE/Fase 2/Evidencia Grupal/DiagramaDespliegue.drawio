        <mxCell id="d42" parent="d37" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#555555;verticalAlign=top;spacingTop=4;spacingRight=18;" value="&lt;font color=&quot;#555555&quot;&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Plantillas de la vista&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Solicitudes, facturas, versiones,&lt;br&gt;usuarios e historial&lt;/font&gt;" vertex="1">
