        </mxCell>
        <mxCell id="d43" parent="d42" style="shape=note;size=5;html=1;fillColor=#FFFFFF;strokeColor=#555555;" value="" vertex="1">
          <mxGeometry height="18" width="14" x="338" y="6" as="geometry" />
        </mxCell>
        <mxCell id="d44" parent="1" style="shape=note;size=15;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFBE6;strokeColor=#B58B00;fontSize=12;" value="&lt;b&gt;Flujo&lt;/b&gt;&lt;br&gt;1. Llega un correo de facturación a la casilla.&lt;br&gt;2. La automatización lo lee y descarga.&lt;br&gt;3. Guarda el correo y sus adjuntos.&lt;br&gt;4. Genera la factura XML v1 y la registra.&lt;br&gt;5. Avisa al usuario que la factura está lista.&lt;br&gt;6. El usuario revisa en la plataforma.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• Con errores: corrige, se guarda v2 (v3…) con registro de cambios y vuelve a revisión.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• Correcta: aprueba.&lt;br&gt;7. La factura aprobada se envía al SII." vertex="1">
          <mxGeometry height="330" width="340" x="1560" y="80" as="geometry" />
        </mxCell>
        <mxCell id="d45" parent="1" style="shape=cube;size=14;flipH=1;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingTop=16;spacingLeft=10;spacingRight=20;fontSize=13;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;fillColor=#F2F2F2;strokeColor=#777777;" value="&lt;font color=&quot;#555555&quot;&gt;«external system»&lt;/font&gt;&lt;br&gt;&lt;b&gt;SII&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Recibe la factura aprobada, la valida y la emite como DTE&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="1560" y="620" as="geometry" />
        </mxCell>
        <mxCell id="d46" parent="1" style="shape=note;size=15;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFBE6;strokeColor=#B58B00;fontSize=12;" value="&lt;b&gt;Por definir&lt;/b&gt;&lt;br&gt;Enviar al SII desde software propio exige certificación ante el SII, certificado digital y folios (CAF). Alternativa: un proveedor de facturación electrónica ya certificado." vertex="1">
          <mxGeometry height="150" width="340" x="1560" y="850" as="geometry" />
        </mxCell>
